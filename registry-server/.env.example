# Bootstrap key. Optional when keys exist in the admin dashboard; when neither
# is configured every /mcp request gets 503 and wrong keys get 401.
REGISTRY_API_KEY=

# Password for the /admin dashboard. Unset disables the dashboard (503).
REGISTRY_ADMIN_PASSWORD=
# Optional separate HMAC secret for admin sessions. Defaults to the password.
# REGISTRY_ADMIN_SECRET=

# Vercel Blob. A store connected in the Vercel dashboard is enough: the SDK
# authenticates with OIDC and BLOB_STORE_ID. Without a store the server falls
# back to .data/*.json, which is fine locally and ephemeral on Vercel.
# BLOB_READ_WRITE_TOKEN is only needed outside Vercel or for a static token.
BLOB_READ_WRITE_TOKEN=

# Optional overrides.
UFME_REGISTRY_BLOB=ufme/library-registry.json
UFME_KEYS_BLOB=ufme/admin-keys.json
# UFME_REGISTRY_FILE=.data/library-registry.json
# UFME_KEYS_FILE=.data/admin-keys.json

# Bot protection (in-memory, per instance). Requests per minute per IP.
UFME_MCP_RATE_MAX=60
UFME_LOGIN_RATE_MAX=10
# Maximum JSON body in bytes.
UFME_MAX_BODY_BYTES=262144
