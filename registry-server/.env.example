# Server-side key. Required: requests without it get 503, wrong keys get 401.
REGISTRY_API_KEY=

# Vercel Blob read-write token. Without it the server falls back to
# .data/library-registry.json, which is fine locally and ephemeral on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional overrides.
UFME_REGISTRY_BLOB=ufme/library-registry.json
# UFME_REGISTRY_FILE=.data/library-registry.json
