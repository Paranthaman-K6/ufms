{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "universal-frontend-master",
  "permission": {
    "bash": {
      "sudo": "deny",
      "sudo *": "deny",
      "pacman": "deny",
      "pacman *": "deny",
      "systemctl": "deny",
      "systemctl *": "deny",
      "doas": "deny",
      "doas *": "deny",
      "pkexec": "deny",
      "pkexec *": "deny",
      "su": "deny",
      "su *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "git push*": "ask",
      "npm publish*": "deny",
      "rm -rf ~/": "deny",
      "rm -rf $HOME": "deny",
      "rm -rf *": "deny",
      "git reset --hard": "deny",
      "curl | bash": "deny"
    }
  }
}